# AfterLedger settings. Copy to .env (python tools/dev.py setup does it) and change what you need.
# Every value has a working default for an offline run: no Google Cloud project, no keys, no network.

# ---- How the API runs ---------------------------------------------------------------------------
# offline: scripted model responses and local adapters only.
# live:    Gemini and the Google Cloud services switched on below (needs credentials, see docs/runbooks/live-run.md).
AL_MODE=offline
# Model source: scripted (offline answers for every agent), gemini (live), or replay (cassettes in AL_LLM_REPLAY_DIR).
AL_LLM=scripted
# With AL_LLM=gemini, every model call is also written here as a cassette, so a live run can be replayed offline.
# Folders in this file are relative to the repository (./.data/cassettes is the repository's own .data).
AL_LLM_RECORD_DIR=
# true: a recording run that was cut off can be run again; requests it already recorded are answered from their
# cassettes (matched by key and by the request's fingerprint), and only the rest go to Gemini.
AL_LLM_RECORD_RESUME=false
AL_LLM_REPLAY_DIR=
# local: JSON files under AL_STATE_DIR.  gcp: Firestore, Cloud Storage and BigQuery (and Cloud Tasks if a queue is set).
AL_STORE=local
# Synthetic families, knowledge and evaluation data (the repository's data/ folder).
AL_DATA_DIR=./data
# Case files, uploads, filled forms and traces written by a local run.
AL_STATE_DIR=./.data
# The six demo cases built once by `python tools/dev.py demos`; the API restores them from here at start.
# (tools/dev.py sets it for you when the folder exists.)
AL_DEMO_BUNDLES=
# Prepare the demo cases when the API starts (restored from the bundles, or played from their timelines).
AL_SEED_ON_START=true
# The demo families' stories are set on their own story days; leave empty to use each family's own.
AL_STORY_DAY=
# system, or fixed:YYYY-MM-DD for a reproducible "today" in new cases.
AL_CLOCK=system
# The clock new activity is written on, as an IANA name (Asia/Kolkata, Asia/Tokyo...); empty for this computer's own.
# Times are shown as written: a demo family's story is on its own clock, wherever it is viewed.
AL_TIMEZONE=
# The most model calls one workflow run may make (a safety net if an agent keeps calling its tools).
AL_MAX_LLM_CALLS=400
# The most tool calls one agent may make in one turn; past it, the agent is told to answer with what it has.
AL_MAX_TOOL_CALLS=16
AL_CORS_ORIGINS=http://localhost:3000
# AfterLedger's own log lines from this level up: DEBUG, INFO or WARNING.
AL_LOG_LEVEL=INFO
# Where the web app is, for links the API writes (an institution's desk link).
AL_PUBLIC_WEB_URL=http://localhost:3000

# ---- Gemini (live) ------------------------------------------------------------------------------------
# Option A, Agent Platform (Vertex AI), signed in with `gcloud auth application-default login`:
#   GOOGLE_GENAI_USE_ENTERPRISE=true, GOOGLE_CLOUD_PROJECT=<your project id>, GOOGLE_CLOUD_LOCATION=global
# Option B, the Gemini Developer API: GOOGLE_API_KEY=<a key from AI Studio>, and GOOGLE_GENAI_USE_ENTERPRISE empty.
# (The Google Cloud services below always need Option A's project and credentials.)
GOOGLE_GENAI_USE_ENTERPRISE=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_KEY=
# A service account key instead of `gcloud auth application-default login` (a path; relative to the repository).
# Keep the key out of the repository's history: .data/ is ignored by git.
GOOGLE_APPLICATION_CREDENTIALS=
AL_MODEL_FLASH=gemini-3.8-flash
AL_MODEL_PRO=gemini-3.1-pro-preview
AL_MODEL_LITE=gemini-3.5-flash-lite
AL_MODEL_LIVE=gemini-3.8-live
# Models that answer the flash agents as well as AL_MODEL_FLASH, tried (after its backup endpoint) when it is slow or
# overloaded, before any smaller model; comma-separated, empty for none. gemini-3.6-flash is retired on the Agent
# Platform on 19 November 2026: change or empty this by then.
AL_MODEL_FLASH_PEERS=gemini-3.6-flash
# On Agent Platform the Live (voice) model runs only in us and eu regions.
AL_LIVE_LOCATION=us-central1

# ---- Google Cloud services (each falls back to its offline adapter when off or not configured) ---------
# Document AI Enterprise Document OCR: the processor's id, and its location (us or eu).
AL_USE_DOCUMENT_AI=true
AL_DOCAI_OCR_PROCESSOR=
AL_DOCAI_LOCATION=us
# Cloud Translation for the words the server writes and the families' copies of letters (reviewed ones first).
AL_USE_TRANSLATION=true
AL_TRANSLATE_LOCATION=global
# The check grounding API (Agent Search) for answers and research quotes.
AL_USE_CHECK_GROUNDING=true
# Research reads the live web; search goes through Gemini's Google Search grounding when AL_LLM=gemini.
AL_USE_LIVE_WEB=true
# An Agent Search data store of official sites, searched before the open web (optional).
AL_USE_AGENT_SEARCH=false
AL_SEARCH_DATASTORE=
AL_SEARCH_LOCATION=global
# Spoken conversation through the Gemini Live API (live runs with AL_LLM=gemini only).
AL_USE_LIVE_VOICE=true

# ---- Google Cloud storage (AL_STORE=gcp) ----------------------------------------------------------------
AL_GCS_BUCKET=
AL_FIRESTORE_DATABASE=(default)
AL_BQ_DATASET=afterledger
# Cloud Tasks for background work that survives a restart (optional; in-process tasks otherwise):
# projects/PROJECT/locations/REGION/queues/QUEUE, with this service's own URL and a shared token.
AL_TASKS_QUEUE=
AL_API_URL=
AL_INTERNAL_TOKEN=

# ---- Accounts ------------------------------------------------------------------------------------------------
# auto: sign-in is required on the public site (AL_SITE=product) and off on a working copy; or required, or off.
# Where it is required, each case belongs to the account that started it; the sample cases stay open to everyone.
AL_AUTH=auto
# The key that signs sign-ins (any long random text). Empty: one is made at each start, and sign-ins end on restart.
AL_AUTH_SECRET=
# The one admin, who sees and manages the other accounts (made or updated at start; 8 characters or more)
AL_ADMIN_EMAIL=
AL_ADMIN_PASSWORD=
AL_ADMIN_NAME=Admin

# ---- The agent harness ----------------------------------------------------------------------------------------
# A live run that must not pass on a stand-in: any Google Cloud service that fails stops the work with its error
# (otherwise the failure is recorded on /v1/meta and the Evaluation page, and the offline stand-in carries on).
AL_STRICT_LIVE=false
# An answer that does not fit the agent's schema is sent back once with the error (0: never).
AL_REASK_MALFORMED=1
# Out of quota or overloaded: pro falls back to flash, flash to lite (false: no fallback, and no backup endpoint).
AL_FALLBACK=true
# A model that is slow or overloaded on its main endpoint (GOOGLE_CLOUD_LOCATION, normally global) is tried first on
# this multi-region endpoint: the same model, so no worse an answer, at about a tenth more per token (us or eu;
# empty: none). Preview models served only on global skip it.
AL_LLM_BACKUP_LOCATION=us
# Seconds a slow endpoint is passed over before it is tried again (twice as long each further time, at most an hour).
AL_LLM_SLOW_COOLDOWN_S=300
# Seconds without an answer before the same request also goes to the backup endpoint (twice this for pro, tool-using
# and image-reading agents). The first answer wins; the other request is cancelled. 0: off.
AL_LLM_HEDGE_AFTER_S=20
# The same for the agents a person waits on as they type or speak (intake, answering questions): sooner.
# 0: as AL_LLM_HEDGE_AFTER_S.
AL_LLM_HEDGE_INTERACTIVE_S=8
# Overloaded or failing on every route (a 500 or 503 spell): seconds to wait before trying the same model once more,
# before a smaller one (0: move down at once).
AL_LLM_OVERLOAD_PAUSE_S=8
# Seconds an agent may take before it is stopped and tried once more (twice this for pro, tool-using and
# image-reading agents). A safety net for a stalled call: reading a long statement takes minutes on a live model.
AL_AGENT_TIMEOUT_S=300
# Seconds one live model request may wait for its answer before it is given up and tried again (twice this for pro,
# tool-using and image-reading agents).
AL_LLM_HTTP_TIMEOUT_S=90
# Most a case may spend, in US dollars, on optional model work (extra research rounds and repairs).
# Empty: no limit. Required steps always run.
AL_CASE_BUDGET_USD=
# Spans to Cloud Trace (needs the Telemetry API and roles/cloudtrace.agent).
AL_TRACE_TO_CLOUD=false
# Outside text (fetched pages, uploaded papers, replies) screened for planted instructions:
# auto (Model Armor when live and a template is set, else patterns), patterns, model_armor or off.
AL_SCREEN=auto
# projects/<project>/locations/us-central1/templates/<template>: a region with the prompt-injection and
# malicious-URI filters and multi-language detection (asia-south1 has neither).
AL_MODEL_ARMOR_TEMPLATE=
# A letter or form that fails its check is repaired and checked again, up to this many rounds (0: no repairs).
AL_REPAIR_ROUNDS=2
# controller: uncertain values, leads and rules go through the decision controller. rules: fixed rules.
AL_DECISIONS=controller
# adaptive: research runs in rounds until its questions are answered. fixed: one pass by two researchers.
AL_RESEARCH_MODE=adaptive
AL_RESEARCH_MAX_ROUNDS=3
AL_RESEARCH_PARALLEL=4

# ---- Web app ------------------------------------------------------------------------------------------------
# Where the browser finds the API, read each time a page is served (python tools/dev.py passes it to the web app;
# a container gets it as an environment variable, so one build runs anywhere).
AL_API_BASE=http://localhost:8080
