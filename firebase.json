{
  "hosting": {
    "site": "afterledger",
    "public": "infra/firebase/public",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "afterledger-web",
          "region": "asia-south1"
        }
      }
    ]
  }
}
